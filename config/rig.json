{
    "tick_hz": 60,
    "calibration_file": "calibration-rig.json",
    "nodes": [
        {
            "id": "front",
            "type": "kinect_v2",
            "params": {
                "extrinsic": { "pos": [0.0, 0.9, -2.0], "rot": [1, 0, 0, 0] }
            }
        },
        {
            "id": "back",
            "type": "kinect_v1",
            "params": {
                "index": 0,
                "tilt_degrees": 0,
                "extrinsic": { "pos": [0.0, 0.9, 2.0], "rot": [0, 0, 1, 0] }
            }
        }
    ],
    "fusion": {
        "stale_seconds": 0.25,
        "outlier_rejection": true,
        "filter": { "min_cutoff": 1.0, "beta": 0.05, "d_cutoff": 1.0 }
    },
    "mapping": {
        "trackers": ["waist", "left_foot", "right_foot"],
        "emit_head": true
    },
    "watchdog": { "enable": true, "silent_seconds": 6.0 },
    "dashboard": { "enable": true, "bind": "127.0.0.1", "port": 8211 },
    "endpoints": [
        { "type": "osc", "params": { "host": "127.0.0.1", "port": 9000 } }
    ]
}
